# Server-side PostgreSQL connection. Use Supabase's transaction pooler URL
# for Netlify, and a direct or session-pooler URL for migration commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
PGPOOL_MAX_CONNECTIONS=1

# Optional server-side Gemini key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_server_side_key
